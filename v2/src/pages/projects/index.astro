---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "@/components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const codeProjects = projects.filter((p) => p.data.category.includes("code"));
const cadProjects = projects.filter((p) => p.data.category.includes("cad"));

const sections = [
  { eyebrow: "Code & ML", projects: codeProjects },
  { eyebrow: "CAD & Design", projects: cadProjects },
].filter((s) => s.projects.length > 0);
---

<BaseLayout
  title="Projects"
  description="A selection of research and applied work in machine learning, robotics, and industrial design."
>
  <section class="container-page pt-20 md:pt-32 pb-10 md:pb-16">
    <div class="max-w-3xl">
      <a
        href="/#projects"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-(--color-muted-foreground) hover:text-(--color-foreground) transition-colors mb-8 uppercase tracking-wider"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        Back
      </a>
      <h1 class="text-4xl md:text-6xl font-semibold tracking-tight text-balance leading-[1.05]">
        Projects
      </h1>
    </div>
  </section>

  <section class="container-page pb-24 md:pb-32 space-y-16 md:space-y-20">
    {sections.map((section) => (
      <div data-reveal>
        <p class="text-xs font-mono text-(--color-muted-foreground) tracking-wider uppercase mb-6 md:mb-8">
          {section.eyebrow}
        </p>

        <div class="grid gap-4 md:gap-5 md:grid-cols-2">
          {section.projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
