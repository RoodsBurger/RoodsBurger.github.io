---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "@/components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Projects"
  description="A selection of research and applied work in machine learning, robotics, and industrial design."
>
  <section class="container-page pt-20 md:pt-32 pb-10 md:pb-16">
    <div class="max-w-3xl">
      <a
        href="/#projects"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-(--color-muted-foreground) hover:text-(--color-foreground) transition-colors mb-8 uppercase tracking-wider"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        Back
      </a>
      <h1 class="text-3xl md:text-5xl font-semibold tracking-tight text-balance leading-[1.05]">
        Projects
      </h1>
    </div>
  </section>

  <section class="container-page pb-24 md:pb-32">
    <div class="grid gap-4 md:gap-5 md:grid-cols-2">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
</BaseLayout>
