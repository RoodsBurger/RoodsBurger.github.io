---
import BaseLayout from "@/layouts/BaseLayout.astro";

const hobbies = [
  {
    title: "Climbing",
    image: "/artifacts/climbing1500_1000.webp",
    description:
      "When not working with robots, I'm solving boulder problems or hanging off a fingerboard. Always down for a session.",
    badge: "V8 Boulderer · Sport 5.12b",
  },
  {
    title: "Ceramics",
    image: "/artifacts/ceramics1200_900.webp",
    description:
      "Pottery is my getaway from the digital world. Always trying new clay bodies and altering shapes on the wheel.",
    badge: "Wheel throwing",
  },
  {
    title: "Teaching",
    image: "/artifacts/apole.webp",
    description:
      "I've taught math and physics to over 1000 underprivileged students in São Paulo and mentor public-school students pursuing higher education.",
    badge: "Volunteering & mentoring",
  },
  {
    title: "Hiking",
    image: "/artifacts/hiking.webp",
    description:
      "On a mission to explore as many US National Parks as possible. Currently planning my first multi-day trek up Kilimanjaro.",
    badge: "Camping & hiking",
  },
];
---

<BaseLayout title="Personal" description="What I get up to outside of code.">
  <section class="container-page pt-20 md:pt-32 pb-14 md:pb-24">
    <div class="max-w-3xl mb-12 md:mb-20">
      <a
        href="/#life"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-(--color-muted-foreground) hover:text-(--color-foreground) transition-colors mb-8 uppercase tracking-wider"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        Back
      </a>
      <h1 class="text-3xl md:text-5xl font-semibold tracking-tight text-balance leading-[1.05]">
        Personal
      </h1>
    </div>

    <div class="grid gap-4 md:gap-5 md:grid-cols-2">
      {hobbies.map((hobby) => (
        <article class="group rounded-2xl border border-(--color-border) bg-(--color-card) overflow-hidden hover:border-(--color-foreground)/30 transition-all duration-300 hover:-translate-y-0.5">
          <div class="aspect-[4/3] overflow-hidden bg-(--color-muted)">
            <img
              src={hobby.image}
              alt={hobby.title}
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
            />
          </div>
          <div class="p-5 md:p-6 space-y-2">
            <h2 class="text-base md:text-lg font-semibold tracking-tight">{hobby.title}</h2>
            <p class="text-sm text-(--color-muted-foreground) leading-relaxed">
              {hobby.description}
            </p>
            {hobby.badge && (
              <p class="text-xs font-mono text-(--color-accent) pt-1">{hobby.badge}</p>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
