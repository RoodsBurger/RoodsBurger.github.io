---
import BaseLayout from "@/layouts/BaseLayout.astro";

const hobbies = [
  {
    title: "Climbing",
    image: "/artifacts/climbing.webp",
    description:
      "Climbing is my main hobby, and when I can't get to a wall I'm hanging off a fingerboard. I'm always up for a session.",
    badge: "V8 Boulderer · Sport 5.12b",
  },
  {
    title: "Ceramics",
    image: "/artifacts/ceramics1200_900.webp",
    description:
      "Pottery is my break from screens. I throw on the wheel, try different clay bodies, and alter the shapes as I go.",
    badge: "Wheel throwing",
  },
  {
    title: "Teaching",
    image: "/artifacts/apole.webp",
    contain: true,
    description:
      "At about 16 I co-founded APOLE, and from 2013 to 2019 we ran free math and physics classes for more than 1,000 public-school students in the state of São Paulo. I also mentor public-school students applying to university.",
    badge: "Volunteering & mentoring",
  },
  {
    title: "Hiking",
    image: "/artifacts/hiking.webp",
    description:
      "I'm working through as many US National Parks as I can, and planning my first multi-day trek, up Kilimanjaro.",
    badge: "Camping & hiking",
  },
];
---

<BaseLayout title="Personal" description="Climbing, ceramics, teaching and hiking.">
  <section class="container-page pt-20 md:pt-32 pb-14 md:pb-24">
    <div class="max-w-3xl mb-12 md:mb-20">
      <a
        href="/#life"
        data-back
        class="inline-flex items-center gap-1.5 text-xs font-mono text-(--color-muted-foreground) hover:text-(--color-foreground) transition-colors mb-8 uppercase tracking-wider"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        Back
      </a>
      <h1 class="text-3xl md:text-5xl font-semibold tracking-tight text-balance leading-[1.05]">
        Personal
      </h1>
    </div>

    <div class="grid gap-4 md:gap-5 md:grid-cols-2">
      {hobbies.map((hobby) => (
        <article class="group flex flex-col rounded-2xl border border-(--color-border) bg-(--color-card) overflow-hidden hover:border-(--color-foreground)/30 transition-all duration-300 hover:-translate-y-0.5">
          <div class="aspect-[4/3] overflow-hidden bg-(--color-muted)">
            <img
              src={hobby.image}
              alt=""
              loading="lazy"
              decoding="async"
              width="1200"
              height="900"
              class:list={[
                "w-full h-full transition-transform duration-700 group-hover:scale-[1.04]",
                hobby.contain ? "object-contain bg-white px-[10%]" : "object-cover",
              ]}
            />
          </div>
          <div class="flex flex-1 flex-col gap-2 p-5 md:p-6">
            <h2 class="text-base md:text-lg font-semibold tracking-tight">{hobby.title}</h2>
            <p class="text-sm text-(--color-muted-foreground) leading-relaxed">
              {hobby.description}
            </p>
            {hobby.badge && (
              <p class="mt-auto text-xs font-mono text-(--color-signal) pt-1">{hobby.badge}</p>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
