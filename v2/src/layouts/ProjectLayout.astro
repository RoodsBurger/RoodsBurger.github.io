---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, tags, links, cover } = project.data;
---

<BaseLayout title={title} description={summary} image={cover} ogType="article">
  <article>
    <header class="border-b border-(--color-border)/40">
      <div class="container-page pt-24 md:pt-32 pb-12 md:pb-16">
        <a
          href="/#projects"
          class="inline-flex items-center gap-1.5 text-xs font-mono text-(--color-muted-foreground) hover:text-(--color-foreground) transition-colors mb-10 uppercase tracking-wider"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          Back
        </a>

        <div class="max-w-4xl space-y-8">
          <h1 class="text-4xl md:text-6xl lg:text-7xl font-semibold tracking-tight text-balance leading-[1.02]">
            {title}
          </h1>

          <p class="text-lg md:text-xl text-(--color-muted-foreground) text-pretty leading-relaxed max-w-2xl">
            {summary}
          </p>

          <div class="flex flex-wrap items-center gap-1.5 pt-1">
            {tags.map((tag) => (
              <span class="text-[11px] font-mono px-2 py-0.5 rounded-full border border-(--color-border) text-(--color-muted-foreground)">
                {tag}
              </span>
            ))}
          </div>

          {(links.github || links.report || links.demo) && (
            <div class="flex flex-wrap gap-2 pt-2">
              {links.github && (
                <a
                  href={links.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm rounded-md border border-(--color-border) px-3.5 py-2 hover:bg-(--color-muted) transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                  GitHub
                </a>
              )}
              {links.report && (
                <a
                  href={links.report}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm rounded-md border border-(--color-border) px-3.5 py-2 hover:bg-(--color-muted) transition-colors"
                >
                  Read report
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                </a>
              )}
              {links.demo && (
                <a
                  href={links.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm rounded-md bg-(--color-foreground) text-(--color-background) px-3.5 py-2 hover:opacity-90 transition-opacity"
                >
                  View demo
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </header>

    <div class="container-page py-12 md:py-16" data-reveal>
      <div class="prose-content max-w-4xl space-y-6 leading-relaxed text-(--color-foreground)">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .prose-content h2 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .prose-content h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-content p {
    color: var(--color-muted-foreground);
    line-height: 1.7;
  }
  .prose-content ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }
  .prose-content ul li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--color-muted-foreground);
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }
  .prose-content ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7rem;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--color-accent);
  }
  .prose-content ol {
    list-style: none;
    counter-reset: ol-counter;
    padding: 0;
  }
  .prose-content ol li {
    counter-increment: ol-counter;
    position: relative;
    padding-left: 2rem;
    color: var(--color-muted-foreground);
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }
  .prose-content ol li::before {
    content: counter(ol-counter);
    position: absolute;
    left: 0;
    top: 0.05rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    font-weight: 600;
  }
  .prose-content a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .prose-content a:hover {
    text-decoration-thickness: 2px;
  }
  .prose-content > img,
  .prose-content > video,
  .prose-content > p > img,
  .prose-content > p > video {
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    margin: 1.5rem 0;
  }
  .prose-content .not-prose img,
  .prose-content .not-prose video {
    margin: 0;
    border: 0;
    border-radius: 0;
  }
</style>
