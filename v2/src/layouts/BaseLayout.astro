---
import "@/styles/globals.css";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import ChatWidget from "@/components/chat/ChatWidget.tsx";
import { site } from "@/lib/site";
import geistLatinUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  showChat?: boolean;
  showNav?: boolean;
  showFooter?: boolean;
  ogType?: "website" | "article";
}

const {
  title,
  description = site.description,
  image = "/og-default.png",
  showChat = true,
  showNav = true,
  showFooter = true,
  ogType = "website",
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const imageUrl = new URL(image, site.url).toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" as="font" type="font/woff2" href={geistLatinUrl} crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script is:inline>
      (function () {
        // Apply the saved theme before paint so there is no FOUC; dark is the default.
        var stored = null;
        try { stored = localStorage.getItem("theme"); } catch (e) {}
        document.documentElement.dataset.theme = stored === "light" ? "light" : "dark";

        // Save the source page's scroll position when a project link is clicked.
        document.addEventListener(
          "click",
          function (e) {
            var t = e.target;
            var a = t && t.closest && t.closest('a[href^="/projects/"]');
            if (!a) return;
            var href = a.getAttribute("href") || "";
            if (href === "/projects" || href === "/projects/") return;
            try {
              sessionStorage.setItem(
                "rr-bg-scroll",
                String(window.scrollY || 0),
              );
            } catch (_) {}
          },
          { capture: true },
        );

        // On a project route, Escape always returns to /#projects.
        var isProject = function () {
          return /^\/projects\/[^/]/.test(location.pathname);
        };
        var escInDialog = false;
        var onKey = function (e) {
          if (e.key !== "Escape" && e.keyCode !== 27) return;
          if (document.querySelector("dialog[open]")) { escInDialog = true; return; }
          if (escInDialog) { if (e.type === "keyup") escInDialog = false; return; }
          if (!isProject()) return;
          window.location.href = "/#projects";
        };
        window.addEventListener("keydown", onKey, true);
        document.addEventListener("keydown", onKey, true);
        window.addEventListener("keyup", onKey, true);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-(--color-accent) focus:text-(--color-accent-foreground) focus:px-4 focus:py-2 focus:rounded-lg"
    >
      Skip to content
    </a>

    {showNav && <Navbar />}

    <main id="main" class="flex-1">
      <slot />
    </main>

    {showFooter && <Footer />}

    {showChat && <ChatWidget mode="floating" client:idle />}

    <script>
      // Behind a project modal the home page shows as-is, so reveals only run on normal pages.
      const behindModal = !!document.querySelector(".project-modal-overlay");

      // Flag enables the data-reveal hidden state; no-JS visitors see everything.
      if (!behindModal) document.documentElement.classList.add("js-reveal");

      // Numbers a section's rendered reveal items (capped at 8 steps) so their delays stagger.
      const indexItems = (section: Element) => {
        let i = 0;
        section.querySelectorAll<HTMLElement>("[data-reveal-item]").forEach((item) => {
          if (!item.getClientRects().length) return;
          item.style.setProperty("--i", String(Math.min(i++, 7)));
        });
      };

      const observe = () => {
        const els = document.querySelectorAll<HTMLElement>(
          "[data-reveal]:not(.is-visible)",
        );
        if (!els.length) return;
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                indexItems(entry.target);
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
      };

      if (!behindModal) observe();

      // Force autoplay reliably across browsers; pause when offscreen to save CPU.
      let videoIO: IntersectionObserver | null = null;
      const playVideos = () => {
        if (videoIO) videoIO.disconnect();
        videoIO = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              const v = e.target as HTMLVideoElement;
              if (e.isIntersecting) v.play?.().catch(() => {});
              else v.pause?.();
            }
          },
          { threshold: 0.1 },
        );
        document
          .querySelectorAll<HTMLVideoElement>("video[autoplay]")
          .forEach((v) => {
            // The mobile media sequence manages its own playback.
            if (v.closest("[data-mediaseq]")) return;
            v.muted = true;
            v.playsInline = true;
            v.play?.().catch(() => {});
            videoIO!.observe(v);
          });
      };
      playVideos();
    </script>
  </body>
</html>
