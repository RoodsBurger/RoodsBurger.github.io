---
import { dimsFor } from "@/lib/media-dims";

interface MediaItem {
  src: string;
  // Optional dark-theme variant of an image; CSS shows the one matching the theme.
  srcDark?: string;
  caption?: string;
  type?: "image" | "video";
  alt?: string;
}

interface Props {
  items: MediaItem[];
  columns?: 2 | 3;
  // Plays the desktop videos as one clock: shared start, held while any clip buffers, restarted together once the longest ends.
  sync?: boolean;
}

const { items, columns = 3, sync = false } = Astro.props;
const gridClass = columns === 2 ? "md:grid-cols-2" : "md:grid-cols-3";

const isVideo = (item: MediaItem) =>
  item.type === "video" || item.src.endsWith(".mp4") || item.src.endsWith(".webm");

const allVideos = items.every(isVideo);
const sequenceId = `mediaseq-${Math.random().toString(36).slice(2, 9)}`;
const syncGroup = sync && allVideos && items.length > 1;
const syncId = `mediasync-${Math.random().toString(36).slice(2, 9)}`;

// The frame is a fixed 4:3 box; this is the fallback intrinsic size when a file can't be read.
const FALLBACK = { width: 1200, height: 900 };

const dims = await Promise.all(items.map((item) => dimsFor(item.src, isVideo(item), FALLBACK)));
const itemsWithDims = items.map((item, i) => ({ ...item, dims: dims[i] }));
---

{/* Desktop: grid */}
<div class={`not-prose hidden md:grid gap-3 md:gap-4 ${gridClass} my-8`} data-mediasync={syncGroup ? syncId : undefined}>
  {itemsWithDims.map((item) => {
    const video = isVideo(item);
    return (
      <figure class="relative rounded-xl overflow-hidden border border-(--color-border) bg-(--color-muted) aspect-[4/3]">
        {video ? (
          <video
            autoplay={!syncGroup}
            loop={!syncGroup}
            muted={true}
            playsinline={true}
            preload={syncGroup ? "none" : "auto"}
            width={item.dims.width}
            height={item.dims.height}
            class="w-full h-full object-cover pointer-events-none [clip-path:inset(0_round_calc(0.75rem-1px))]"
            aria-label={item.alt || item.caption}
          >
            <source src={item.src} type="video/mp4" />
          </video>
        ) : (
          <>
            <img
              src={item.src}
              alt={item.alt || item.caption || ""}
              loading="lazy"
              decoding="async"
              width={item.dims.width}
              height={item.dims.height}
              class:list={["w-full h-full object-cover", item.srcDark && "cover-when-light"]}
            />
            {item.srcDark && (
              <img
                src={item.srcDark}
                alt={item.alt || item.caption || ""}
                loading="lazy"
                decoding="async"
                width={item.dims.width}
                height={item.dims.height}
                class="w-full h-full object-cover cover-when-dark"
              />
            )}
          </>
        )}
        {item.caption && (
          <figcaption class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent px-3 py-2 text-xs text-white font-medium">
            {item.caption}
          </figcaption>
        )}
      </figure>
    );
  })}
</div>

{/* Mobile: cycle through one at a time (videos) or a vertical stack (images) */}
{allVideos && itemsWithDims.length > 1 ? (
  <figure
    class="not-prose md:hidden relative rounded-xl overflow-hidden border border-(--color-border) bg-(--color-muted) aspect-[4/3] my-8"
    data-mediaseq={sequenceId}
  >
    {itemsWithDims.map((item, i) => (
      <video
        data-mediaseq-idx={i}
        data-mediaseq-caption-text={item.caption || ""}
        muted={true}
        playsinline={true}
        preload="none"
        width={item.dims.width}
        height={item.dims.height}
        class="absolute inset-0 w-full h-full object-cover pointer-events-none transition-opacity duration-500 [clip-path:inset(0_round_calc(0.75rem-1px))]"
        style={`opacity: ${i === 0 ? 1 : 0};`}
        aria-label={item.alt || item.caption}
      >
        <source src={item.src} type="video/mp4" />
      </video>
    ))}
    <figcaption
      data-mediaseq-caption
      class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent px-3 py-2 text-xs text-white font-medium"
    >
      {itemsWithDims[0].caption}
    </figcaption>
  </figure>
) : (
  <div class={`not-prose md:hidden my-8`}>
    {itemsWithDims.slice(0, 1).map((item) => {
      const video = isVideo(item);
      return (
        <figure class="relative rounded-xl overflow-hidden border border-(--color-border) bg-(--color-muted) aspect-[4/3]">
          {video ? (
            <video
              autoplay={true}
              loop={true}
              muted={true}
              playsinline={true}
              preload="auto"
              width={item.dims.width}
              height={item.dims.height}
              class="w-full h-full object-cover pointer-events-none [clip-path:inset(0_round_calc(0.75rem-1px))]"
              aria-label={item.alt || item.caption}
            >
              <source src={item.src} type="video/mp4" />
            </video>
          ) : (
            <>
              <img
                src={item.src}
                alt={item.alt || item.caption || ""}
                loading="lazy"
                decoding="async"
                width={item.dims.width}
                height={item.dims.height}
                class:list={["w-full h-full object-cover", item.srcDark && "cover-when-light"]}
              />
              {item.srcDark && (
                <img
                  src={item.srcDark}
                  alt={item.alt || item.caption || ""}
                  loading="lazy"
                  decoding="async"
                  width={item.dims.width}
                  height={item.dims.height}
                  class="w-full h-full object-cover cover-when-dark"
                />
              )}
            </>
          )}
          {item.caption && (
            <figcaption class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent px-3 py-2 text-xs text-white font-medium">
              {item.caption}
            </figcaption>
          )}
        </figure>
      );
    })}
  </div>
)}

{allVideos && itemsWithDims.length > 1 && (
  <script
    is:inline
    define:vars={{ sequenceId }}
  >
    (() => {
      const root = document.querySelector(`[data-mediaseq="${sequenceId}"]`);
      if (!root) return;
      const videos = Array.from(root.querySelectorAll("video"));
      const captionEl = root.querySelector("[data-mediaseq-caption]");
      videos.forEach((v) => {
        v.muted = true;
        v.playsInline = true;
      });
      let current = 0;
      const advance = () => {
        const next = (current + 1) % videos.length;
        videos[current].style.opacity = "0";
        videos[next].style.opacity = "1";
        videos[next].currentTime = 0;
        videos[next].play().catch(() => {});
        if (captionEl) captionEl.textContent = videos[next].dataset.mediaseqCaptionText || "";
        current = next;
      };
      videos.forEach((v) => v.addEventListener("ended", advance));
      // The sequence only loads and plays on narrow screens, where it is the visible copy.
      const mobile = window.matchMedia("(max-width: 767.98px)");
      const start = () => {
        if (!mobile.matches) {
          videos.forEach((v) => v.pause());
          return;
        }
        videos.forEach((v) => (v.preload = "auto"));
        videos[current].play().catch(() => {});
      };
      mobile.addEventListener("change", start);
      start();
    })();
  </script>
)}

{syncGroup && (
  <script
    is:inline
    define:vars={{ syncId }}
  >
    (() => {
      const root = document.querySelector(`[data-mediasync="${syncId}"]`);
      if (!root) return;
      const videos = Array.from(root.querySelectorAll("video"));
      const desktop = window.matchMedia("(min-width: 768px)");
      videos.forEach((v) => {
        v.muted = true;
        v.playsInline = true;
      });

      // The longest clip is the group clock; shorter clips hold their last frame until it ends.
      let lead = videos[0];
      let running = false;
      let visible = false;
      let timer = 0;
      const done = (v) => v.ended || v.currentTime >= v.duration - 0.05;
      const ready = (v) => v.readyState >= 3 || done(v);
      const playAll = () => videos.forEach((v) => !done(v) && v.paused && v.play().catch(() => {}));
      const pauseAll = () => videos.forEach((v) => !v.paused && v.pause());

      const restart = () => {
        videos.forEach((v) => {
          v.playbackRate = 1;
          v.currentTime = 0;
        });
      };

      // Every 200ms: hold the group while any clip is buffering, then nudge each clip's rate (or seek when far off) toward the clock.
      const tick = () => {
        if (!running || !visible) return;
        // Under an open project modal the group stays paused.
        if (root.closest("[inert]")) {
          pauseAll();
          return;
        }
        if (lead.ended) {
          restart();
          return;
        }
        if (!videos.every(ready)) {
          pauseAll();
          return;
        }
        playAll();
        const t = lead.currentTime;
        videos.forEach((v) => {
          if (v === lead || done(v)) return;
          const drift = Math.min(t, v.duration) - v.currentTime;
          if (Math.abs(drift) > 0.5) {
            v.currentTime = Math.min(t, v.duration);
            v.playbackRate = 1;
          } else if (Math.abs(drift) > 0.04) {
            v.playbackRate = 1 + Math.max(-0.1, Math.min(0.1, drift * 0.5));
          } else {
            v.playbackRate = 1;
          }
        });
      };

      const start = () => {
        if (running || !desktop.matches) return;
        running = true;
        videos.forEach((v) => {
          v.preload = "auto";
          if (v.readyState === 0) v.load();
        });
        const meta = (v) =>
          v.readyState >= 1 ? Promise.resolve() : new Promise((r) => v.addEventListener("loadedmetadata", r, { once: true }));
        Promise.all(videos.map(meta)).then(() => {
          lead = videos.reduce((a, b) => (b.duration > a.duration ? b : a));
          restart();
          timer = window.setInterval(tick, 200);
          tick();
        });
      };

      // Offscreen or hidden groups pause together and resume in step.
      new IntersectionObserver(
        (entries) => {
          visible = entries.some((e) => e.isIntersecting);
          if (visible) {
            start();
            tick();
          } else {
            pauseAll();
          }
        },
        { threshold: 0.1 },
      ).observe(root);
      desktop.addEventListener("change", () => (desktop.matches ? start() : pauseAll()));
    })();
  </script>
)}
