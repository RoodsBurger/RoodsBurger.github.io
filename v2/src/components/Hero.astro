---
import { site } from "@/lib/site";
import Experience from "@/components/Experience.astro";

// Glyphs match the footer's icon set.
const links = [
  {
    href: site.social.linkedin,
    label: "LinkedIn",
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle>',
  },
  {
    href: site.social.github,
    label: "GitHub",
    icon: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path>',
  },
];
---

<section id="about" class="relative overflow-hidden">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-(--color-border) to-transparent" aria-hidden="true"></div>

  <div class="container-page relative pt-10 pb-10 md:pt-16 md:pb-14">
    <div class="intro">
      <div class="intro-photo relative aspect-square w-full rounded-xl md:rounded-2xl overflow-hidden border border-(--color-border) bg-(--color-muted) animate-in">
        <img
          src="/artifacts/profile.webp"
          alt="Rodolfo sitting on the floor next to Tobias, his quadruped robot"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="800"
          height="800"
          class="w-full h-full object-cover"
        />
      </div>

      <h1 class="intro-name text-[2.375rem] md:text-5xl lg:text-[3.25rem] font-semibold tracking-tight text-balance leading-[1.05] animate-in">
        {site.name}
      </h1>

      <ul class="intro-links flex items-center animate-in" aria-label="Profiles">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              class="grid place-items-center size-10 rounded-lg text-(--color-muted-foreground) hover:text-(--color-foreground) hover:bg-(--color-muted) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-foreground) transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={link.icon} />
            </a>
          </li>
        ))}
      </ul>

      <div class="intro-body max-w-2xl space-y-3 text-base md:text-[1.0625rem] leading-[1.6] text-pretty animate-in">
        <p class="text-(--color-foreground)">
          I build at the intersection of deep learning, reinforcement learning,
          and robotics. The goal is usually to get algorithms to do something
          useful in the physical world.
        </p>
        <p class="text-(--color-muted-foreground)">
          I'm a Research Scientist on Pindrop's Authentication &amp; ID
          Research team. I work on the voice authentication models Pindrop
          sells to banks, and with the bank teams that validate them. I've
          written about <a href="https://www.pindrop.com/resources/article/agentic-ai-for-model-development-docs" target="_blank" rel="noopener noreferrer" class="intro-link">a Claude agent that cut each model document from 25 days to 8</a>
          and about <a href="https://www.pindrop.com/resources/article/automating-voice-migration-from-existing-audio" target="_blank" rel="noopener noreferrer" class="intro-link">voice migration</a>,
          where our offline enrollment work went from proofs of concept to
          more than 3 million production enrollments. During my master's, I
          was a research assistant in Columbia's Creative Machines Lab.
        </p>
      </div>
    </div>

    <div class="mt-10 md:mt-12 animate-in">
      <Experience />
    </div>
  </div>
</section>

<style>
  /* Mobile: photo with icons beside it, then name and body full width. */
  .intro {
    display: grid;
    grid-template-columns: 120px 1fr;
    grid-template-areas:
      "photo links"
      "name name"
      "body body";
    column-gap: 1rem;
  }
  .intro-photo { grid-area: photo; }
  .intro-name { grid-area: name; margin-top: 1.25rem; }
  .intro-links { grid-area: links; justify-self: end; align-self: start; margin-top: -0.625rem; margin-right: -0.625rem; }
  .intro-body { grid-area: body; margin-top: 0.875rem; }
  .intro-link {
    color: var(--color-foreground);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
    transition: text-decoration-color 150ms;
  }
  .intro-link:hover { text-decoration-color: currentColor; }

  /* Desktop: photo spans the block; flexible outer rows keep the text centred beside it. */
  @media (min-width: 768px) {
    .intro {
      grid-template-columns: 200px minmax(0, 1fr) auto;
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas:
        "photo . ."
        "photo name links"
        "photo body body"
        "photo . .";
      column-gap: 2.5rem;
    }
    .intro-name { margin-top: 0; }
    .intro-links { align-self: center; margin-top: 0; }
    .intro-body { margin-top: 1rem; }
  }
  @media (min-width: 1024px) {
    .intro { grid-template-columns: 224px minmax(0, 1fr) auto; column-gap: 3rem; }
  }
</style>
