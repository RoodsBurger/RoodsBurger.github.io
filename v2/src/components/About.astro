<section id="about" class="container-page py-14 md:py-24 border-t border-(--color-border)" data-reveal>
  <div class="grid md:grid-cols-[140px_1fr] lg:grid-cols-[160px_1fr] gap-8 md:gap-10 lg:gap-12 items-center max-w-3xl">
    <div class="relative aspect-square w-24 md:w-full rounded-2xl overflow-hidden border border-(--color-border) bg-(--color-muted)">
      <img
        src="/artifacts/profile.png"
        alt="Portrait of Rodolfo Raimundo"
        loading="lazy"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="space-y-4">
      <p class="text-xs font-mono text-(--color-muted-foreground) tracking-wider uppercase">About</p>

      <div class="space-y-3 text-base md:text-lg text-(--color-foreground) leading-relaxed text-pretty">
        <p>
          I build at the intersection of deep learning, reinforcement learning,
          and robotics. The goal is usually to get algorithms to do something
          useful in the physical world.
        </p>
        <p class="text-(--color-muted-foreground)">
          Currently a Research Scientist at Pindrop. Previously a Graduate
          Research Assistant at Columbia's Creative Machines Lab.
        </p>
      </div>
    </div>
  </div>
</section>
