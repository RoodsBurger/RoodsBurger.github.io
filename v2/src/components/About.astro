<section id="about" class="container-page py-20 md:py-28 border-t border-(--color-border)/40" data-reveal>
  <div class="grid md:grid-cols-[140px_1fr] lg:grid-cols-[180px_1fr] gap-8 md:gap-12 lg:gap-16 items-start max-w-4xl">
    <div class="relative aspect-square w-28 md:w-full rounded-2xl overflow-hidden border border-(--color-border) bg-(--color-muted)">
      <img
        src="/artifacts/profile.png"
        alt="Portrait of Rodolfo Raimundo"
        loading="lazy"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="space-y-5">
      <p class="text-xs font-mono text-(--color-muted-foreground) tracking-wider uppercase">About</p>

      <div class="space-y-4 text-lg md:text-xl text-(--color-foreground) leading-relaxed text-pretty font-light">
        <p>
          I build at the intersection of deep learning, reinforcement learning,
          and robotics. The goal is usually to get algorithms to do something
          useful in the physical world.
        </p>
        <p class="text-(--color-muted-foreground)">
          Currently a Research Scientist at Pindrop. Previously a Graduate
          Research Assistant at Columbia's Creative Machines Lab.
        </p>
      </div>
    </div>
  </div>
</section>
