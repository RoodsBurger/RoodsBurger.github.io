---
// A grid of same-ratio thumbnails that open a native-dialog lightbox with keyboard navigation.
interface Item {
  src: string;
  alt: string;
}

interface Props {
  items: Item[];
  ratio?: "1/1" | "4/5" | "16/10";
  columns?: 2 | 3;
}

const { items, ratio = "1/1", columns = 3 } = Astro.props;

// Aspect classes are written out literally so Tailwind's content scan picks them up.
const ASPECT_CLASS: Record<string, string> = {
  "1/1": "aspect-square",
  "4/5": "aspect-[4/5]",
  "16/10": "aspect-[16/10]",
};
const aspectClass = ASPECT_CLASS[ratio];

// Width/height attributes only need to carry the right ratio to avoid layout shift.
const DIMS: Record<string, [number, number]> = {
  "1/1": [1000, 1000],
  "4/5": [800, 1000],
  "16/10": [1600, 1000],
};
const [thumbWidth, thumbHeight] = DIMS[ratio];

const gridClass = columns === 2 ? "md:grid-cols-2" : "md:grid-cols-3";
// A 3-item gallery would otherwise wrap to 2 columns plus an orphan tile on mobile.
const mobileColsClass = items.length === 3 ? "grid-cols-3" : "grid-cols-2";
const galleryId = `gallery-${Math.random().toString(36).slice(2, 9)}`;
const descId = `${galleryId}-desc`;
---

<div class="not-prose my-8" data-gallery={galleryId}>
  <div class={`grid ${mobileColsClass} gap-3 md:gap-4 ${gridClass}`}>
    {items.map((item) => (
      <button
        type="button"
        class={`group relative ${aspectClass} rounded-xl overflow-hidden border border-(--color-border) bg-(--color-muted) focus-visible:outline focus-visible:outline-2 focus-visible:outline-(--color-ring) focus-visible:outline-offset-2`}
        data-gallery-thumb
        aria-label={`Open ${item.alt}`}
      >
        <img
          src={item.src}
          alt={item.alt}
          loading="lazy"
          decoding="async"
          width={thumbWidth}
          height={thumbHeight}
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      </button>
    ))}
  </div>

  <dialog data-gallery-dialog class="gallery-dialog" aria-label="Image viewer" aria-describedby={descId}>
    <button type="button" data-gallery-close aria-label="Close" class="gallery-close">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
    {items.length > 1 && (
      <button type="button" data-gallery-prev aria-label="Previous image" class="gallery-nav gallery-prev">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>
    )}
    <img data-gallery-image src="" alt="" decoding="async" class="gallery-image" />
    {items.length > 1 && (
      <button type="button" data-gallery-next aria-label="Next image" class="gallery-nav gallery-next">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    )}
    <span data-gallery-desc id={descId} class="sr-only"></span>
  </dialog>
</div>

<style>
  .gallery-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    background: transparent;
    border: none;
    padding: 0;
  }
  .gallery-dialog[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gallery-dialog::backdrop {
    background: color-mix(in oklab, var(--color-background) 60%, transparent);
    backdrop-filter: blur(20px) saturate(1.2);
  }
  .gallery-image {
    max-width: min(92vw, 1200px);
    max-height: 85vh;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    object-fit: contain;
  }
  .gallery-close,
  .gallery-nav {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: color-mix(in oklab, var(--color-card) 90%, transparent);
    color: var(--color-foreground);
    cursor: pointer;
  }
  .gallery-close:hover,
  .gallery-nav:hover {
    background: var(--color-muted);
  }
  .gallery-close {
    top: 1rem;
    right: 1rem;
    width: 2.5rem;
    height: 2.5rem;
  }
  .gallery-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 2.75rem;
    height: 2.75rem;
  }
  .gallery-prev {
    left: 1rem;
  }
  .gallery-next {
    right: 1rem;
  }
</style>

<script is:inline define:vars={{ galleryId }}>
  (() => {
    const root = document.querySelector(`[data-gallery="${galleryId}"]`);
    if (!root) return;
    const dialog = root.querySelector("[data-gallery-dialog]");
    const image = dialog.querySelector("[data-gallery-image]");
    const description = dialog.querySelector("[data-gallery-desc]");
    const thumbs = Array.from(root.querySelectorAll("[data-gallery-thumb]"));
    const closeBtn = dialog.querySelector("[data-gallery-close]");
    const prevBtn = dialog.querySelector("[data-gallery-prev]");
    const nextBtn = dialog.querySelector("[data-gallery-next]");

    let current = 0;
    let opener = null;

    const show = (index) => {
      current = (index + thumbs.length) % thumbs.length;
      const thumbImg = thumbs[current].querySelector("img");
      image.src = thumbImg.src;
      image.alt = thumbImg.alt;
      description.textContent = thumbImg.alt;
    };

    const open = (index, trigger) => {
      opener = trigger;
      show(index);
      dialog.showModal();
    };

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener("click", () => open(i, thumb));
    });

    closeBtn.addEventListener("click", () => dialog.close());
    prevBtn?.addEventListener("click", () => show(current - 1));
    nextBtn?.addEventListener("click", () => show(current + 1));

    // A click on the dialog element itself (not its content) is a backdrop click.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Arrow keys move between items; Escape closes via the dialog's own native behavior.
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") {
        e.preventDefault();
        show(current + 1);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        show(current - 1);
      }
    });

    dialog.addEventListener("close", () => {
      opener?.focus();
    });
  })();
</script>
