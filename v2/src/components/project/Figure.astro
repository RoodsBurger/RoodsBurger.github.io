---
// A single bordered, rounded figure at a fixed aspect ratio: an image or a muted looping video.
interface Props {
  src: string;
  alt: string;
  caption?: string;
  ratio?: "16/10" | "4/5" | "1/1" | "3/2";
  video?: boolean;
  poster?: string;
  size?: "full" | "sm";
}

const { src, alt, caption, ratio = "16/10", video = false, poster, size = "full" } = Astro.props;

// Aspect classes are written out literally so Tailwind's content scan picks them up.
const ASPECT_CLASS: Record<string, string> = {
  "16/10": "aspect-[16/10]",
  "4/5": "aspect-[4/5]",
  "1/1": "aspect-square",
  "3/2": "aspect-[3/2]",
};
const aspectClass = ASPECT_CLASS[ratio];

// "sm" caps the figure at 60% of the prose column on desktop, centred; mobile stays full width.
const SIZE_CLASS: Record<string, string> = {
  full: "",
  sm: "md:max-w-[60%] md:mx-auto",
};
const sizeClass = SIZE_CLASS[size];

// Width/height attributes only need to carry the right ratio to avoid layout shift.
const DIMS: Record<string, [number, number]> = {
  "16/10": [1600, 1000],
  "4/5": [800, 1000],
  "1/1": [1000, 1000],
  "3/2": [2400, 1600],
};
const [width, height] = DIMS[ratio];

const base = src.replace(/\.(webm|mp4)$/, "");
const webmSrc = `${base}.webm`;
const mp4Src = `${base}.mp4`;
---

<figure class={`not-prose my-8 ${sizeClass}`}>
  <div class={`${aspectClass} rounded-xl overflow-hidden isolate border border-(--color-border) bg-(--color-muted)`}>
    {video ? (
      <video
        width={width}
        height={height}
        muted
        playsinline
        preload="none"
        poster={poster}
        class="w-full h-full object-cover [clip-path:inset(0_round_calc(0.75rem-1px))]"
        aria-label={alt}
        data-figure-video
      >
        <source src={webmSrc} type="video/webm" />
        <source src={mp4Src} type="video/mp4" />
      </video>
    ) : (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover"
      />
    )}
  </div>
  {caption && (
    <figcaption class="mt-3 font-mono text-xs text-(--color-muted-foreground)">
      {caption}
    </figcaption>
  )}
</figure>

{video && (
  <script>
    // With reduced motion, show a static first frame with native controls instead of autoplaying.
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll<HTMLVideoElement>("video[data-figure-video]").forEach((v) => {
      if (reduce) {
        v.controls = true;
        v.preload = "metadata";
      } else {
        v.loop = true;
        v.autoplay = true;
        v.preload = "auto";
        v.play?.().catch(() => {});
      }
    });
  </script>
)}
