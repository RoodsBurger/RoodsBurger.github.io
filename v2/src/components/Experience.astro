---
type LogoKind = "image" | "image-mono" | "image-with-yc" | "wordmark";

interface ExperienceItem {
  name: string;
  href: string;
  kind: LogoKind;
  logo?: string;
  logoClass?: string;
  wordmarkText?: string;
  wordmarkClass?: string;
  wordmarkColor?: string;
}

const items: ExperienceItem[] = [
  {
    name: "Pindrop",
    href: "https://www.pindrop.com",
    kind: "image",
    logo: "/logos/pindrop.png",
    logoClass: "max-h-16 md:max-h-20 max-w-[92%]",
  },
  {
    name: "Columbia University",
    href: "https://www.columbia.edu",
    kind: "image",
    logo: "/logos/columbia.png",
  },
  {
    name: "Next Caller, Y Combinator backed",
    href: "https://www.ycombinator.com/companies/next-caller",
    kind: "image-with-yc",
    logo: "/logos/next-caller.png",
  },
  {
    name: "Stanford University",
    href: "https://online.stanford.edu/non-degree-options",
    kind: "image",
    logo: "/logos/stanford.svg",
  },
  {
    name: "Morgan Stanley",
    href: "https://www.morganstanley.com",
    kind: "image-mono",
    logo: "/logos/morgan-stanley.svg",
  },
  {
    name: "Universidade de São Paulo",
    href: "https://www5.usp.br",
    kind: "image-mono",
    logo: "/logos/usp.svg",
  },
  {
    name: "groupwork Brasil",
    href: "https://groupwork.com.br/",
    kind: "wordmark",
    wordmarkText: "groupwork",
    wordmarkClass:
      "text-lg md:text-xl font-mono font-medium lowercase tracking-tight",
  },
  {
    name: "nok9",
    href: "https://www.nok9.com",
    kind: "wordmark",
    wordmarkText: "nok9",
    wordmarkClass:
      "text-2xl md:text-3xl font-mono font-bold lowercase tracking-tight",
  },
  {
    name: "manroland",
    href: "https://www.manrolandgoss.com",
    kind: "wordmark",
    wordmarkText: "manroland",
    wordmarkClass: "text-lg md:text-xl font-sans font-bold tracking-tight",
  },
];

const groups = [0, 1, 2];
---

<div id="experience" class="exp-marquee relative">
  <div id="exp-scroll" class="exp-scroll flex overflow-x-auto">
    {
      groups.map((g) => (
        <div
          class="exp-group flex gap-3 md:gap-4 pr-3 md:pr-4 shrink-0"
          aria-hidden={g === 0 ? undefined : "true"}
        >
          {items.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.name}
              title={item.name}
              tabindex={g === 0 ? undefined : -1}
              draggable={false}
              class="group exp-card relative flex items-center justify-center rounded-2xl border border-(--color-border) bg-(--color-card) shrink-0 size-28 md:size-32 hover:border-(--color-foreground)/40 transition-colors duration-300 overflow-hidden"
            >
              {item.kind === "image" && (
                <img
                  src={item.logo}
                  alt={item.name}
                  loading="lazy"
                  draggable={false}
                  class:list={[
                    "exp-logo w-auto object-contain transition-all duration-300",
                    item.logoClass || "max-h-14 md:max-h-16 max-w-[80%]",
                  ]}
                />
              )}

              {item.kind === "image-mono" && (
                <div
                  aria-label={item.name}
                  role="img"
                  class="exp-logo-mono h-14 md:h-16 w-[80%] transition-all duration-300"
                  style={`-webkit-mask: url(${item.logo}) center/contain no-repeat; mask: url(${item.logo}) center/contain no-repeat;`}
                />
              )}

              {item.kind === "image-with-yc" && (
                <div class="flex flex-col items-center justify-center gap-1 md:gap-1.5 px-3 w-full">
                  <img
                    src={item.logo}
                    alt={item.name}
                    loading="lazy"
                    draggable={false}
                    class="exp-logo h-7 md:h-8 max-w-[80%] w-auto object-contain transition-all duration-300"
                  />
                  <img
                    src="/logos/yc.svg"
                    alt="Y Combinator"
                    loading="lazy"
                    draggable={false}
                    class="exp-logo h-4 md:h-5 w-auto object-contain rounded-sm transition-all duration-300"
                  />
                </div>
              )}

              {item.kind === "wordmark" && (
                <span
                  class:list={[
                    "exp-wordmark text-center max-w-[85%] transition-all duration-300",
                    item.wordmarkClass,
                  ]}
                  style={`color: ${item.wordmarkColor || "var(--color-foreground)"};`}
                >
                  {item.wordmarkText || item.name}
                </span>
              )}
            </a>
          ))}
        </div>
      ))
    }
  </div>

  <div
    class="pointer-events-none absolute inset-y-0 left-0 w-12 md:w-16 bg-gradient-to-r from-(--color-background) to-transparent"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-y-0 right-0 w-12 md:w-16 bg-gradient-to-l from-(--color-background) to-transparent"
  >
  </div>
</div>

<style>
  /* Hide the scrollbar entirely while keeping the element scrollable */
  .exp-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: auto;
    cursor: grab;
    overscroll-behavior-x: contain;
  }
  .exp-scroll::-webkit-scrollbar {
    display: none;
  }
  .exp-scroll.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .exp-logo {
    filter: grayscale(0.85) brightness(0.9);
    opacity: 0.5;
  }
  .exp-card:hover .exp-logo {
    filter: none;
    opacity: 1;
  }
  .exp-wordmark {
    opacity: 0.55;
  }
  .exp-card:hover .exp-wordmark {
    opacity: 1;
  }
  .exp-logo-mono {
    background-color: var(--color-muted-foreground);
    opacity: 0.7;
  }
  .exp-card:hover .exp-logo-mono {
    background-color: var(--color-foreground);
    opacity: 1;
  }
</style>

<script>
  const initExperience = () => {
    const scroller = document.getElementById("exp-scroll");
    if (!scroller || scroller.dataset.bound === "1") return;
    scroller.dataset.bound = "1";

    const group = scroller.querySelector(".exp-group") as HTMLElement | null;
    if (!group) return;

    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let span = group.getBoundingClientRect().width;

    const normalize = () => {
      if (span <= 0) return 0;
      // Keep the position within the middle copy so it loops both ways.
      let shift = 0;
      while (scroller.scrollLeft >= span * 2) {
        scroller.scrollLeft -= span;
        shift -= span;
      }
      while (scroller.scrollLeft < span) {
        scroller.scrollLeft += span;
        shift += span;
      }
      return shift;
    };

    const recenter = () => {
      span = group.getBoundingClientRect().width;
      if (span > 0) scroller.scrollLeft = span;
    };

    // All listeners + the rAF loop are torn down the moment this element
    // leaves the DOM (e.g. an Astro client-side navigation swaps the body).
    // Without this, every navigation back would stack another forever-running
    // rAF loop and a fresh set of listeners, slowing the whole site over time.
    const ac = new AbortController();
    const signal = ac.signal;
    const stop = () => ac.abort();

    requestAnimationFrame(recenter);
    window.addEventListener("load", recenter, { signal });
    window.addEventListener("resize", recenter, { signal });

    let hovering = false;
    let lastInteract = 0;
    const mark = () => {
      lastInteract = performance.now();
    };

    scroller.addEventListener("mouseenter", () => { hovering = true; }, { signal });
    scroller.addEventListener("mouseleave", () => { hovering = false; }, { signal });
    scroller.addEventListener(
      "wheel",
      () => {
        mark();
        normalize();
      },
      { passive: true, signal },
    );
    scroller.addEventListener("touchstart", mark, { passive: true, signal });
    scroller.addEventListener(
      "touchmove",
      () => {
        mark();
        normalize();
      },
      { passive: true, signal },
    );
    scroller.addEventListener("scroll", normalize, { passive: true, signal });

    // Pointer drag-to-scroll (desktop)
    let dragging = false;
    let moved = false;
    let startX = 0;
    let startLeft = 0;

    scroller.addEventListener("pointerdown", (e) => {
      dragging = true;
      moved = false;
      startX = e.clientX;
      startLeft = scroller.scrollLeft;
      mark();
    }, { signal });
    scroller.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 5) {
        moved = true;
        scroller.classList.add("is-dragging");
      }
      scroller.scrollLeft = startLeft - dx;
      startLeft += normalize();
      mark();
    }, { signal });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      scroller.classList.remove("is-dragging");
      mark();
    };
    scroller.addEventListener("pointerup", endDrag, { signal });
    scroller.addEventListener("pointercancel", endDrag, { signal });
    scroller.addEventListener("pointerleave", endDrag, { signal });
    // Suppress the click that follows a real drag so it doesn't navigate.
    scroller.addEventListener(
      "click",
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      },
      { capture: true, signal },
    );

    let prev = performance.now();
    const SPEED = 0.04; // px per ms
    const tick = (t: number) => {
      // Self-terminate once detached so navigations don't stack loops.
      if (!scroller.isConnected) {
        stop();
        return;
      }
      const dt = t - prev;
      prev = t;
      const idle = t - lastInteract > 1500;
      if (!reduce && !hovering && !dragging && idle && span > 0) {
        scroller.scrollLeft += SPEED * dt;
        normalize();
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  initExperience();
</script>
