---
import { site } from "@/lib/site";
import ThemeToggle from "@/components/ThemeToggle.tsx";
---

<header
  id="site-header"
  class="sticky top-0 z-40 w-full transition-all duration-300 data-[scrolled=true]:border-b data-[scrolled=true]:border-(--color-border)/60 data-[scrolled=true]:bg-(--color-background)/80 data-[scrolled=true]:backdrop-blur-xl bg-transparent border-b border-transparent"
>
  <div class="container-page flex h-14 items-center justify-between gap-4">
    <a href="/" class="flex items-baseline gap-2 font-mono text-sm tracking-tight leading-none">
      <span
        class="inline-block size-2 rounded-full bg-(--color-accent) animate-pulse-slow translate-y-[-1px]"
        aria-hidden="true"
      ></span>
      <span class="font-semibold">{site.shortName}</span>
      <span class="text-(--color-muted-foreground)">.me</span>
    </a>

    <div class="flex items-center gap-2">
      <nav class="hidden md:flex items-center gap-1 text-sm mr-2" aria-label="Primary">
        {site.nav.map((item) => (
          <a
            href={item.href}
            class="px-3 py-1.5 rounded-lg text-(--color-muted-foreground) hover:text-(--color-foreground) hover:bg-(--color-muted) transition-colors"
          >
            {item.label}
          </a>
        ))}
      </nav>
      <ThemeToggle client:idle />
      <button
        id="mobile-menu-button"
        type="button"
        class="md:hidden p-2 rounded-lg text-(--color-muted-foreground) hover:bg-(--color-muted) hover:text-(--color-foreground)"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-(--color-border)/40 bg-(--color-background)"
  >
    <nav class="container-page py-3 flex flex-col gap-1" aria-label="Mobile">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class="px-3 py-2 rounded-lg text-(--color-muted-foreground) hover:text-(--color-foreground) hover:bg-(--color-muted) transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const setup = () => {
    const btn = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    btn?.addEventListener("click", () => {
      const open = menu?.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", String(open));
    });

    document
      .querySelectorAll<HTMLAnchorElement>("#mobile-menu a")
      .forEach((link) => {
        link.addEventListener("click", () => {
          menu?.classList.add("hidden");
          btn?.setAttribute("aria-expanded", "false");
        });
      });

    const header = document.getElementById("site-header");
    const update = () => {
      if (!header) return;
      header.dataset.scrolled = String(window.scrollY > 8);
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
  };

  setup();
  document.addEventListener("astro:page-load", setup);
</script>
