---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, tags, links } = project.data;
---

{/* True overlay modal — rendered on top of the actual home page so the
    backdrop blurs the real content beneath it (navbar-style effect). */}
<div
  class="project-modal-overlay fixed inset-0 z-[60] overflow-y-auto overscroll-contain"
>
  <a
    href="/#projects"
    class="project-backdrop fixed inset-0 -z-10"
    aria-label="Close project"
    data-project-backdrop
  ></a>

  <article
    class="project-modal animate-modal-in relative max-w-4xl mx-auto my-12 md:my-20 px-4 md:px-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="project-modal-title"
  >
    <div class="project-card">
      <header class="relative px-6 md:px-10 pt-6 md:pt-8 pb-8 md:pb-10 border-b border-(--color-border)/60">
        <a
          href="/#projects"
          aria-label="Close"
          class="absolute top-4 right-4 md:top-5 md:right-5 size-9 rounded-full border border-(--color-border) flex items-center justify-center text-(--color-muted-foreground) hover:text-(--color-foreground) hover:bg-(--color-muted) transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
          </svg>
        </a>

        <div class="space-y-6 md:space-y-8">
          <h1
            id="project-modal-title"
            class="text-4xl md:text-6xl font-semibold tracking-tight text-balance leading-[1.05]"
          >
            {title}
          </h1>

          <p class="text-lg md:text-xl text-(--color-muted-foreground) text-pretty leading-relaxed">
            {summary}
          </p>

          <div class="flex flex-wrap items-center gap-1.5 pt-1">
            {tags.map((tag) => (
              <span class="text-[11px] font-mono px-2 py-0.5 rounded-full border border-(--color-border) text-(--color-muted-foreground)">
                {tag}
              </span>
            ))}
          </div>

          {(links.github || links.report || links.demo) && (
            <div class="flex flex-wrap gap-2 pt-2">
              {links.github && (
                <a
                  href={links.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm rounded-lg border border-(--color-border) px-3.5 py-2 hover:bg-(--color-muted) transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                  GitHub
                </a>
              )}
              {links.report && (
                <a
                  href={links.report}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm rounded-lg border border-(--color-border) px-3.5 py-2 hover:bg-(--color-muted) transition-colors"
                >
                  Read report
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                </a>
              )}
              {links.demo && (
                <a
                  href={links.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm rounded-lg bg-(--color-foreground) text-(--color-background) px-3.5 py-2 hover:opacity-90 transition-opacity"
                >
                  View demo
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                </a>
              )}
            </div>
          )}
        </div>
      </header>

      <div class="px-6 md:px-10 py-10 md:py-14">
        <div class="prose-content space-y-6 leading-relaxed text-(--color-foreground)">
          <slot />
        </div>
      </div>
    </div>
  </article>
</div>

<style>
  .project-backdrop {
    cursor: pointer;
    background: color-mix(in oklab, var(--color-background) 55%, transparent);
    backdrop-filter: blur(28px) saturate(1.2);
    -webkit-backdrop-filter: blur(28px) saturate(1.2);
  }

  .project-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    box-shadow:
      0 30px 60px -20px color-mix(in oklab, black 35%, transparent),
      0 10px 30px -10px color-mix(in oklab, black 25%, transparent);
    overflow: hidden;
  }

  .animate-modal-in {
    animation: modal-in 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes modal-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.99);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-modal-in { animation: none; }
  }
</style>

<style is:global>
  /* Lock body scroll while the project modal is open so the page
     behind stays put. */
  body:has(.project-modal-overlay) {
    overflow: hidden;
  }

  .prose-content h2 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .prose-content h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-content p {
    color: var(--color-muted-foreground);
    line-height: 1.7;
  }
  .prose-content ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }
  .prose-content ul li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--color-muted-foreground);
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }
  .prose-content ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7rem;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--color-accent);
  }
  .prose-content ol {
    list-style: none;
    counter-reset: ol-counter;
    padding: 0;
  }
  .prose-content ol li {
    counter-increment: ol-counter;
    position: relative;
    padding-left: 2rem;
    color: var(--color-muted-foreground);
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }
  .prose-content ol li::before {
    content: counter(ol-counter);
    position: absolute;
    left: 0;
    top: 0.05rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    font-weight: 600;
  }
  .prose-content a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .prose-content a:hover {
    text-decoration-thickness: 2px;
  }
  .prose-content > img,
  .prose-content > video,
  .prose-content > p > img,
  .prose-content > p > video {
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    margin: 1.5rem 0;
  }
  .prose-content .not-prose img,
  .prose-content .not-prose video {
    margin: 0;
    border: 0;
    border-radius: 0;
  }
</style>

<script is:inline>
  (() => {
    // Restore the source scroll position: when the user clicks a
    // project link the BaseLayout saved window.scrollY. Pin the body
    // via position:fixed so the page behind shows at exactly that spot
    // (and so it can't be scrolled while the modal is open).
    let savedY = 0;
    try {
      const raw = sessionStorage.getItem("rr-bg-scroll");
      sessionStorage.removeItem("rr-bg-scroll");
      if (raw != null) savedY = parseInt(raw, 10) || 0;
    } catch (_) {}
    const b = document.body;
    b.style.position = "fixed";
    b.style.top = `-${savedY}px`;
    b.style.left = "0";
    b.style.right = "0";
    b.style.width = "100%";

    // Esc closes the project popup (back to /#projects). Inline + capture
    // phase on window so the listener attaches as the HTML is parsed and
    // fires before any descendant (3D viewer / chat) can consume it.
    const onKey = (e) => {
      if (e.key !== "Escape" && e.keyCode !== 27) return;
      window.location.href = "/#projects";
    };
    window.addEventListener("keydown", onKey, { capture: true });
    document.addEventListener("keydown", onKey, { capture: true });
  })();
</script>
