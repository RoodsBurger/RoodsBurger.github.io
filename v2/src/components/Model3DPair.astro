---
import Model3D from "./Model3D.astro";

interface Item {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  items: [Item, Item];
  height?: string;
}

const { items, height = "440px" } = Astro.props;
---

{/* Two 3D viewers side by side on desktop; only the second one (right) on mobile. */}
<div
  class="not-prose my-8 grid grid-cols-1 md:grid-cols-2 gap-4 [&_figure]:my-0"
>
  <div class="hidden md:block">
    <Model3D
      src={items[0].src}
      alt={items[0].alt}
      caption={items[0].caption}
      height={height}
    />
  </div>
  <Model3D
    src={items[1].src}
    alt={items[1].alt}
    caption={items[1].caption}
    height={height}
  />
</div>
