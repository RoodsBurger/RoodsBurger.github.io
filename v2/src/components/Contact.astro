---
import { site } from "@/lib/site";
---

<section id="contact" class="container-page py-12 md:py-16 border-t border-(--color-border)/40" data-reveal>
  <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div class="space-y-1.5">
      <p class="text-xs font-mono text-(--color-muted-foreground) tracking-wider uppercase">Contact</p>
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">
        Let's build something.
      </h2>
    </div>

    <div class="flex items-center gap-2 flex-wrap">
      <a
        href={`mailto:${site.email}`}
        class="inline-flex items-center gap-2 rounded-md bg-(--color-foreground) text-(--color-background) px-4 py-2 text-sm font-medium hover:opacity-90 transition-opacity"
      >
        Email
      </a>
      <a
        href={site.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-md border border-(--color-border) px-4 py-2 text-sm font-medium hover:bg-(--color-muted) transition-colors"
      >
        LinkedIn
      </a>
    </div>
  </div>
</section>
