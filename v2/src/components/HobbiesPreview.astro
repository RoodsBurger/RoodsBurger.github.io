---
const hobbies = [
  {
    title: "Climbing",
    description: "Bouldering and sport climbing - problem-solving with your whole body.",
    image: "/artifacts/climbing1500_1000.png",
  },
  {
    title: "Ceramics",
    description: "Wheel-thrown vessels. There's a quiet joy in making the same bowl ten times until it's right.",
    image: "/artifacts/ceramics1200_900.png",
  },
  {
    title: "Hiking",
    description: "Long days outside. The best ideas show up around mile 7.",
    image: "/artifacts/hiking.png",
  },
];
---

<section id="hobbies" class="container-page py-16 md:py-24 border-t border-(--color-border)/40">
  <div class="flex items-end justify-between gap-6 mb-10 md:mb-12">
    <div class="space-y-2">
      <p class="text-sm font-mono text-(--color-accent) tracking-wider uppercase">Beyond code</p>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">Outside the lab</h2>
    </div>
    <a
      href="/hobbies"
      class="hidden sm:inline-flex items-center gap-1.5 text-sm text-(--color-muted-foreground) hover:text-(--color-foreground) transition-colors"
    >
      All hobbies
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>

  <div class="grid gap-5 md:gap-6 md:grid-cols-3">
    {hobbies.map((hobby) => (
      <article class="group rounded-2xl border border-(--color-border) bg-(--color-card) overflow-hidden hover:border-(--color-foreground)/30 transition-colors">
        <div class="aspect-[4/3] overflow-hidden bg-(--color-muted)">
          <img
            src={hobby.image}
            alt={hobby.title}
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
          />
        </div>
        <div class="p-5 space-y-2">
          <h3 class="font-semibold tracking-tight">{hobby.title}</h3>
          <p class="text-sm text-(--color-muted-foreground) leading-relaxed">{hobby.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>
