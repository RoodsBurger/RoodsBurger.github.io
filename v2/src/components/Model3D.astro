---
interface Props {
  /** Path to a .glb (or .gltf) file exported from Fusion 360 (via Blender). */
  src: string;
  alt: string;
  caption?: string;
  height?: string;
  environment?: string;
}

const DEFAULT_ENVIRONMENT =
  "https://modelviewer.dev/shared-assets/environments/whipple_creek_regional_park_04_1k.hdr";

const { src, alt, caption, height = "480px", environment = DEFAULT_ENVIRONMENT } = Astro.props;
---

<figure
  class="viewer-grid not-prose my-8 relative rounded-xl overflow-hidden border border-(--color-border) bg-(--color-muted)"
  style={`height: ${height};`}
  aria-label={alt}
>
  <model-viewer
    src={src}
    alt={alt}
    camera-controls
    auto-rotate
    auto-rotate-delay="2500"
    rotation-per-second="18deg"
    interaction-prompt="none"
    environment-image={environment}
    shadow-intensity="0.85"
    shadow-softness="0.95"
    exposure="1.1"
    tone-mapping="aces"
    loading="lazy"
    reveal="auto"
    style="width: 100%; height: 100%; background: transparent; --poster-color: transparent;"
  >
    <div
      slot="poster"
      class="absolute inset-0 flex items-center justify-center text-xs font-mono text-(--color-muted-foreground) tracking-wider uppercase"
    >
      Loading model…
    </div>
    <div
      slot="progress-bar"
      class="absolute bottom-0 left-0 h-0.5 bg-(--color-foreground)/30"
    >
    </div>
  </model-viewer>

  <div
    class="pointer-events-none absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-(--color-card)/80 backdrop-blur-sm px-2.5 py-1 text-[11px] font-mono text-(--color-muted-foreground) border border-(--color-border)/60"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="11"
      height="11"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
      ></path>
      <path d="m3.3 7 8.7 5 8.7-5"></path>
      <path d="M12 22V12"></path>
    </svg>
    Drag to rotate · scroll to zoom
  </div>

  {
    caption && (
      <figcaption class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent px-4 py-3 text-sm text-white font-medium pointer-events-none">
        {caption}
      </figcaption>
    )
  }
</figure>

<script>
  // Defines <model-viewer> only once a viewer is within 200px of the viewport; the poster stays visible until then.
  let importStarted = false;
  const ensureModelViewer = () => {
    if (importStarted) return;
    importStarted = true;
    import("@google/model-viewer");
  };

  const viewers = document.querySelectorAll("model-viewer");
  if (!("IntersectionObserver" in window)) {
    ensureModelViewer();
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          ensureModelViewer();
          io.disconnect();
        }
      },
      { rootMargin: "200px" },
    );
    viewers.forEach((el) => io.observe(el));
  }
</script>

<style>
  /* A finer, stronger grid than the page texture, behind the transparent 3D canvas */
  .viewer-grid {
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--color-border) 45%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--color-border) 45%, transparent) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: center center;
  }
</style>
