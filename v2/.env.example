# Cohere API — used for embeddings + chat responses
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Pinecone vector DB — used for RAG over knowledge base
# https://app.pinecone.io
PINECONE_API_KEY=
INDEX_NAME=

