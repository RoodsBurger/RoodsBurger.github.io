# COHERE_CHAT_MODEL=command-a-03-2025
# Overrides NAMESPACE_DEFAULT in src/lib/chat/models.ts
# PINECONE_NAMESPACE=v2-20260929

# Optional: enables the detailed healthcheck at ?healthcheck=<token>
# HEALTHCHECK_TOKEN=
